# Single-instance lab candidate. Evaluate false positives/latency before production.
# Does not change Kubernetes replica counts or start services.
# No credentials: supply strong authentication and tenant policies separately.
BULWARK_FAIL_MODE=closed
BULWARK_SCANNERS_PIPELINE_ENABLED=true
BULWARK_INPUT_DLP_ENABLED=true
BULWARK_INPUT_DLP_MAX_BYTES=65536
# Strict file admission: inspect inline text; reject images/opaque documents.
BULWARK_ATTACHMENT_GUARD_ENABLED=true
BULWARK_ATTACHMENT_MAX_FILE_BYTES=16000
BULWARK_ATTACHMENT_MAX_TOTAL_BYTES=65536
BULWARK_ATTACHMENT_MAX_COUNT=5
BULWARK_MCP_SCANNING_ENABLED=true
BULWARK_MCP_SCANNING_BLOCKING=true
BULWARK_LONG_CONTEXT_SCANNING_ENABLED=true
BULWARK_LONG_CONTEXT_SCANNING_BLOCKING=true
BULWARK_LONG_CONTEXT_MAX_SCAN_BYTES=65536
# High-FP contact fields need corporate policy approval; do not silently enable.
BULWARK_REDACT_EMAIL=false
BULWARK_REDACT_PHONE=false
# Audit writes require bounded storage and a destination. Delivery is at least once.
BULWARK_TELEMETRY_ENABLED=true
BULWARK_TELEMETRY_DURABLE=true
BULWARK_TELEMETRY_SHARED_OUTBOX=false
BULWARK_TELEMETRY_DISK_PATH=data/telemetry_outbox.db
BULWARK_TELEMETRY_DB_MAX_SIZE=52428800
BULWARK_TELEMETRY_DB_MAX_EVENTS=100000
# Local outbox profile: one worker, one owner per persistent path (not shared HA).
BULWARK_WORKERS=1
# Models must be provisioned and evaluated before adding a semantic profile.
BULWARK_ML_ENABLED=false
