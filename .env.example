# Bulwark Gateway — Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#
# This file is used by docker-compose.yml for LOCAL DEVELOPMENT only.
# In Kubernetes, secrets are managed via K8s Secrets (see k8s/secrets/).

# ─── Backend (upstream LLM/Agent API) ───────────────────────────────────────
BULWARK_BACKEND_URL=http://host.docker.internal:8000
BULWARK_LOG_LEVEL=INFO
BULWARK_FAIL_MODE=closed

# Host port to publish the proxy on (the container always listens on 8080).
# 8080 often collides with other local services; 8085 is a safe default.
BULWARK_PORT=8085

# ─── Output Filter — opt-in PII redaction ───────────────────────────────────
# Secrets, credentials, SSNs, credit cards and IBANs are ALWAYS redacted.
# Emails and phone numbers are frequently *legitimate* agent output (e.g. a
# support bot returning a contact address), so their redaction is opt-in to
# avoid breaking legitimate flows. Enable for stricter tenants (e.g. healthcare).
BULWARK_REDACT_EMAIL=false
BULWARK_REDACT_PHONE=false

# ─── Auth Secrets (CHANGE THESE — use: openssl rand -hex 32) ────────────────
BULWARK_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
ADMIN_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
ADMIN_PASSWORD=change-me-use-strong-password

# ─── Optional users (CHANGE IN PRODUCTION) ──────────────────────────────────
SECURITY_PASSWORD=change-me-use-strong-password
AUDITOR_PASSWORD=change-me-use-strong-password

# ─── Admin Portal ───────────────────────────────────────────────────────────
ADMIN_DEBUG=false

# ─── GDPR Art.30 RoPA (Records of Processing Activities) ─────────────────────
# These name the data controller and DPO in the /admin/gdpr/data-inventory
# report. Leave empty and the endpoint honestly reports "NOT CONFIGURED"
# rather than a fabricated placeholder (Art.30(1)(a) mandatory fields).
BULWARK_GDPR_CONTROLLER=
BULWARK_GDPR_CONTROLLER_CONTACT=
BULWARK_GDPR_DPO_CONTACT=

# ─── Telemetry / SIEM Export ────────────────────────────────────────────────
BULWARK_TELEMETRY_ENABLED=true
BULWARK_TELEMETRY_BATCH_SIZE=100
BULWARK_TELEMETRY_FLUSH_INTERVAL=1.0
BULWARK_SIEM_STATS_FILE=shared/siem/siem_stats.json

# ─── IOC Feed API Keys (obtain from respective providers) ───────────────────
# Leave empty if not using threat intel feeds
BULWARK_URLHAUS_KEY=
BULWARK_THREATFOX_KEY=
BULWARK_OTX_KEY=
BULWARK_ABUSEIPDB_KEY=

# ─── Enrichment (optional — requires ML models) ────────────────────────────
BULWARK_ENRICHMENT_ENABLED=false

# ─── ML Scanners (optional — requires ONNX models in ./models/) ─────────────
# Set INSTALL_ML=true when building the Docker image to include dependencies.
# Models: injection-classifier (~738MB), toxicity (~260MB)
# Download: python scripts/download-models.py
BULWARK_ML_ENABLED=false
BULWARK_ML_MODEL_DIR=models
BULWARK_ML_BLOCKING=false
# Build arg for docker-compose:
INSTALL_ML=false

# ─── Redis ──────────────────────────────────────────────────────────────────
BULWARK_REDIS_URL=redis://redis:6379/0

# ─── Grafana (docker-compose --profile full) ────────────────────────────────
GRAFANA_PASSWORD=change-me-use-strong-password
