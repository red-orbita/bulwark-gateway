# Isolated regression environment, never a release image. Named contexts contain
# source tests/scripts only, no workspace root or operator data.
FROM python:3.14-slim-trixie@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170 AS tooling
WORKDIR /build
COPY requirements.lock requirements-admin.lock requirements-test.lock ./
COPY --from=testsrc /packaging_locks.py /build/tests/packaging_locks.py
COPY --from=testlocks /requirements-test-cp314.lock /build/native-test.lock
RUN python tests/packaging_locks.py ci > /build/ci.lock && \
    python -m pip install --no-cache-dir --target /packages --python-version 3.14 \
      --only-binary=:all: --require-hashes -r ci.lock -r requirements-test.lock -r native-test.lock
FROM cgr.dev/chainguard/python@sha256:1c4deeea85db49ab5f6bcd9e7fc0bf3fd8439e99f7bde45330f40400685eb394
COPY --from=tooling /packages /usr/lib/python3.14/site-packages
COPY src /app/src
COPY admin /app/admin
COPY config /app/config
COPY pyproject.toml requirements.lock requirements-admin.lock requirements-postgres.lock /app/
COPY --from=testsrc / /app/tests/
COPY --from=scriptsrc / /app/scripts/
COPY --from=testlocks / /app/docker/
COPY --from=helmsrc / /app/helm/
COPY --from=workflowsrc / /app/.github/
COPY --from=examplesrc / /app/examples/
ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 OPENBLAS_NUM_THREADS=1
WORKDIR /app
USER 65532:65532
ENTRYPOINT ["python3", "-m", "pytest", "-p", "pytest_asyncio.plugin", "-p", "pytest_httpx", "-o", "cache_dir=/tmp/pytest-cache", "--basetemp=/tmp/pytest-work"]
