# ============================================================
# Bulwark Gateway — Admin Portal
# Separate service, zero impact on proxy hot path
# H-08 fix: Pin base image to SHA256 digest (prevents supply chain poisoning)
# ============================================================
FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a AS builder

WORKDIR /build

# Install build deps for pysqlcipher3 + yara-python (required by SkillSpector)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libsqlcipher-dev git \
    libyara-dev automake libtool make pkg-config && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY requirements-admin.lock .
# All admin dependencies (including redis, PyJWT, asyncpg, aiosqlite,
# python-multipart) are now hash-pinned in requirements-admin.lock — see
# docker/requirements-admin.in for the source-of-truth direct deps. A single
# --require-hashes install guarantees a reproducible, tamper-evident build.
RUN pip install --no-cache-dir --require-hashes -r requirements-admin.lock

# Install NVIDIA SkillSpector from GitHub (Apache 2.0)
# Provides 64 vulnerability patterns, AST analysis, taint tracking, YARA signatures, OSV.dev CVE lookups
# SECURITY: Disabled by default until a verified release exists.
# To enable: pass --build-arg SKILLSPECTOR_COMMIT=<verified-sha> at build time.
ARG SKILLSPECTOR_COMMIT=""
RUN if [ -n "$SKILLSPECTOR_COMMIT" ]; then \
      pip install --no-cache-dir "git+https://github.com/NVIDIA/SkillSpector.git@${SKILLSPECTOR_COMMIT}" && \
      echo "INFO: SkillSpector installed (commit: ${SKILLSPECTOR_COMMIT})" || \
      echo "WARN: SkillSpector install failed — falling back to built-in scanner"; \
    else \
      echo "INFO: SkillSpector not installed (no SKILLSPECTOR_COMMIT provided)"; \
    fi

# ============================================================
FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a AS runtime

LABEL org.opencontainers.image.title="bulwark-gateway-admin"
LABEL org.opencontainers.image.description="Admin portal for Bulwark Gateway"
LABEL org.opencontainers.image.version="0.4.3"

# Runtime deps for SQLCipher (runtime library only, not -dev headers)
# SECURITY FIX (APT-21): install the runtime shared library only (no headers,
# no dev tools) to reduce attack surface.
# Debian bumped the SONAME package name libsqlcipher0 -> libsqlcipher1, so try
# the newer name first and fall back for older bases (keeps the build portable).
# SECURITY: also upgrade ALL installed OS packages to the latest security-patched
# versions in the pinned base's Debian (trixie) apt snapshot. This clears the
# fixable Trivy findings across perl(-base), openssl, ncurses, glibc (libc6),
# libsqlite3, tar, gzip, bzip2, zlib1g, libacl1, libattr1, libpam*, util-linux
# and systemd libraries. Folded into a single apt layer. CVEs with no released
# Debian fix remain until upstream ships one (expected).
RUN apt-get update && \
    (apt-get install -y --no-install-recommends libsqlcipher1 || \
     apt-get install -y --no-install-recommends libsqlcipher0) && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r bulwark && useradd -r -g bulwark -s /bin/false bulwark

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY src/ src/
COPY admin/ admin/
COPY config/ config/

# Create writable directories for audit DB and backups
# Remove pip to reduce post-exploitation surface
RUN mkdir -p data reports config/policies/.backup && \
    chown -R bulwark:bulwark /app && \
    rm -f /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12 && \
    rm -rf /usr/local/lib/python3.12/site-packages/pip \
           /usr/local/lib/python3.12/site-packages/pip-*.dist-info

USER bulwark

EXPOSE 8090

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; \
try: urllib.request.urlopen('http://127.0.0.1:8090/admin/health'); \
except: sys.exit(1)"

CMD ["python", "-m", "uvicorn", "admin.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8090", \
     "--log-level", "info", \
     "--timeout-keep-alive", "65", \
     "--no-server-header"]
