{
  "_comment": "ULTRA-RESTRICTIVE Seccomp-BPF profile for Bulwark Gateway Plugin Sandbox. Blocks: network (socket/connect/bind), process execution (execve), filesystem writes (outside /tmp), ptrace, all admin syscalls. Plugins run in PURE COMPUTATION mode.",
  "defaultAction": "SCMP_ACT_ERRNO",
  "defaultErrnoRet": 1,
  "archMap": [
    {
      "architecture": "SCMP_ARCH_X86_64",
      "subArchitectures": ["SCMP_ARCH_X86", "SCMP_ARCH_X32"]
    },
    {
      "architecture": "SCMP_ARCH_AARCH64",
      "subArchitectures": []
    }
  ],
  "syscalls": [
    {
      "_comment": "Core: memory management, file descriptors (read-only), threading, signals, time",
      "names": [
        "access",
        "arch_prctl",
        "brk",
        "clock_getres", "clock_gettime", "clock_nanosleep",
        "clone", "clone3",
        "close", "close_range",
        "dup", "dup2", "dup3",
        "epoll_create", "epoll_create1", "epoll_ctl", "epoll_wait", "epoll_pwait",
        "eventfd", "eventfd2",
        "exit", "exit_group",
        "faccessat", "faccessat2",
        "fadvise64",
        "fcntl",
        "flock",
        "fstat", "fstatat64", "fstatfs",
        "futex", "futex_waitv",
        "get_robust_list",
        "getcwd",
        "getdents", "getdents64",
        "getegid", "geteuid", "getgid", "getgroups",
        "getpgid", "getpgrp", "getpid", "getppid",
        "getrandom",
        "getresgid", "getresuid",
        "getrlimit",
        "gettid",
        "gettimeofday",
        "getuid",
        "ioctl",
        "lseek",
        "lstat",
        "madvise",
        "membarrier",
        "mincore",
        "mlock", "mlock2",
        "mmap", "mmap2",
        "mprotect",
        "mremap",
        "msync",
        "munlock",
        "munmap",
        "nanosleep",
        "newfstatat",
        "open", "openat", "openat2",
        "pause",
        "pipe", "pipe2",
        "poll", "ppoll",
        "prctl",
        "pread64", "preadv",
        "prlimit64",
        "pselect6",
        "read", "readahead",
        "readlink", "readlinkat",
        "readv",
        "restart_syscall",
        "rseq",
        "rt_sigaction", "rt_sigpending", "rt_sigprocmask", "rt_sigreturn",
        "rt_sigtimedwait",
        "sched_getaffinity", "sched_getattr", "sched_getparam",
        "sched_getscheduler", "sched_yield",
        "select",
        "set_robust_list",
        "set_tid_address",
        "setitimer",
        "sigaltstack",
        "stat", "statfs", "statx",
        "sysinfo",
        "tgkill",
        "time",
        "timer_create", "timer_delete", "timer_getoverrun",
        "timer_gettime", "timer_settime",
        "timerfd_create", "timerfd_gettime", "timerfd_settime",
        "tkill",
        "umask",
        "uname",
        "wait4", "waitid"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "WRITE operations: only allow write/pwrite to already-open FDs (stdout/stderr/tmp). Cannot open new files for writing via O_WRONLY/O_RDWR due to seccomp arg filtering below.",
      "names": [
        "write", "writev",
        "pwrite64", "pwritev"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Allow ftruncate and fsync (for /tmp sqlite if needed)",
      "names": ["ftruncate", "fsync", "fdatasync", "fallocate"],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Allow mkdir/unlink/rename in /tmp only (enforced by read_only filesystem + tmpfs)",
      "names": ["mkdir", "mkdirat", "unlink", "unlinkat", "rename", "renameat", "renameat2", "rmdir", "truncate"],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "BLOCKED: All network syscalls — plugins CANNOT make network connections",
      "names": [
        "socket", "socketpair",
        "connect", "accept", "accept4",
        "bind", "listen",
        "sendto", "sendmsg", "sendmmsg", "sendfile",
        "recvfrom", "recvmsg", "recvmmsg",
        "getsockname", "getpeername", "getsockopt", "setsockopt",
        "shutdown",
        "splice"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 13
    },
    {
      "_comment": "BLOCKED: Process execution — plugins CANNOT spawn processes",
      "names": ["execve", "execveat"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: ptrace (anti-debugging, anti-container-escape)",
      "names": ["ptrace", "process_vm_readv", "process_vm_writev"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: Mount/filesystem manipulation",
      "names": ["mount", "umount", "umount2", "pivot_root", "chroot"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: Kernel module operations",
      "names": ["init_module", "finit_module", "delete_module", "create_module"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: All privilege escalation",
      "names": [
        "setuid", "setgid", "setreuid", "setregid",
        "setresuid", "setresgid", "setfsuid", "setfsgid",
        "setgroups", "setpgid", "setsid",
        "capset"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: Namespace/container escape",
      "names": ["setns", "unshare", "personality"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: Admin/kernel operations",
      "names": [
        "acct", "add_key", "bpf", "clock_adjtime", "clock_settime",
        "kexec_file_load", "kexec_load", "keyctl",
        "lookup_dcookie", "nfsservctl",
        "open_by_handle_at", "perf_event_open",
        "quotactl", "reboot",
        "request_key", "setdomainname", "sethostname",
        "settimeofday",
        "swapon", "swapoff",
        "syslog", "userfaultfd",
        "vm86", "vm86old", "vmsplice",
        "ioperm", "iopl",
        "io_setup", "io_destroy", "io_submit", "io_cancel", "io_getevents"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: Signaling other processes (only self/thread allowed via tgkill/tkill above)",
      "names": ["kill"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "args": [
        { "index": 0, "value": 0, "op": "SCMP_CMP_NE" }
      ]
    },
    {
      "_comment": "Allow kill(0, sig) for self-signaling only",
      "names": ["kill"],
      "action": "SCMP_ACT_ALLOW",
      "args": [
        { "index": 0, "value": 0, "op": "SCMP_CMP_EQ" }
      ]
    }
  ]
}
