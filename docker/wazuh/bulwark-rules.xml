<!-- ECS JSON emitted by the Bulwark telemetry exporter. -->
<group name="bulwark-gateway,">
  <rule id="100120" level="3">
    <decoded_as>json</decoded_as>
    <field name="observer.type" type="pcre2">^bulwark-gateway$</field>
    <field name="event.kind" type="pcre2">^event$</field>
    <field name="bulwark.guardrail_layer" type="pcre2">^request_audit$</field>
    <description>Bulwark request activity: HTTP $(labels.http_status_code) ($(bulwark.request_id))</description>
    <group>bulwark_activity,</group>
  </rule>
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="observer.type" type="pcre2">^bulwark-gateway$</field>
    <field name="bulwark.verdict" type="pcre2">^(block|warn|redact|allow)$</field>
    <description>Bulwark Gateway: $(bulwark.verdict) event $(event.id)</description>
  </rule>
  <rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <field name="bulwark.verdict" type="pcre2">^block$</field>
    <description>Bulwark Gateway: threat blocked for $(tenant.id)</description>
    <group>attack,</group>
  </rule>
  <rule id="100102" level="7">
    <if_sid>100100</if_sid>
    <field name="bulwark.verdict" type="pcre2">^warn$</field>
    <description>Bulwark Gateway: suspicious activity warning</description>
  </rule>
  <rule id="100103" level="5">
    <if_sid>100100</if_sid>
    <field name="bulwark.verdict" type="pcre2">^redact$</field>
    <description>Bulwark Gateway: sensitive output redacted</description>
  </rule>
  <rule id="100110" level="12">
    <if_sid>100101</if_sid>
    <field name="bulwark.threat_category" type="pcre2">^prompt_injection$</field>
    <description>Bulwark Gateway: prompt injection blocked ($(event.id))</description>
    <group>injection,</group>
  </rule>
  <rule id="100111" level="11">
    <if_sid>100101</if_sid>
    <field name="bulwark.threat_category" type="pcre2">^tool_abuse$</field>
    <description>Bulwark Gateway: unauthorized tool call blocked</description>
    <group>policy_violation,</group>
  </rule>
</group>
