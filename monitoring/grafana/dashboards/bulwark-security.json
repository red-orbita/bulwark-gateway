{
  "id": null,
  "uid": "bulwark-security",
  "title": "Bulwark Gateway — Security Operations",
  "description": "Security-focused dashboard for SOC teams: attack categories, severity, pattern matches, per-tenant blocks, and SIEM export health.",
  "tags": ["bulwark", "security", "soc", "attacks"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Operational Overview",
      "url": "/grafana/d/bulwark-overview/bulwark-gateway-operational-overview",
      "type": "link",
      "icon": "apps",
      "targetBlank": false
    },
    {
      "title": "SLO / Error Budget",
      "url": "/grafana/d/bulwark-slo/bulwark-gateway-slo-error-budget",
      "type": "link",
      "icon": "bolt",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Security Alerts",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "ALERTS{alertname=~\"Bulwark(HighBlockRate|PromptInjectionSpike|ToolPolicyViolations|CriticalDetectionSpike)\", alertstate=\"firing\"}",
        "iconColor": "red",
        "titleFormat": "{{alertname}}",
        "tagKeys": "severity,mitre_attack"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "category",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(bulwark_detections_by_category_total, category)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "timerange",
        "type": "interval",
        "query": "1m,5m,15m,30m,1h,6h,12h,1d",
        "current": { "text": "5m", "value": "5m" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Attack Attempts per Minute (by Category)",
      "description": "Guardrail detections (block+warn) by threat category (bulwark:detections:category).",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (category)(rate(bulwark_detections_by_category_total{category=~\"$category\"}[$timerange])) * 60",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "title": "Critical Detections (1h)",
      "description": "Critical-severity guardrail detections in the last hour (bulwark:detections:severity).",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(bulwark_detections_by_severity_total{severity=\"critical\"}[1h]))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "title": "Total Blocks (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "orange", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(bulwark_verdicts_total{verdict=\"block\"}[24h]))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "title": "SIEM Export Rate",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "evt/s",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "bulwark:siem:export_rate_5m",
          "legendFormat": "Events/sec exported",
          "refId": "A"
        },
        {
          "expr": "sum(rate(bulwark_siem_export_errors_total[5m]))",
          "legendFormat": "Errors/sec",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 5,
      "title": "Matched Patterns (Top 10)",
      "description": "Guardrail pattern matches by pattern id (bulwark:detections:pattern, top 200 exported).",
      "type": "barchart",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "scheme"
          }
        }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (pattern_id)(bulwark_pattern_matches_total))",
          "legendFormat": "{{pattern_id}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "legend": { "displayMode": "list", "placement": "right" },
        "tooltip": { "mode": "single" }
      },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true }
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Detections by Severity",
      "description": "Guardrail detection rate broken down by severity (bulwark:detections:severity).",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 5,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "critical" }, "properties": [{ "id": "color", "value": { "fixedColor": "dark-red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "high" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "medium" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "low" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "expr": "sum by (severity)(rate(bulwark_detections_by_severity_total[$timerange]))",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "title": "Detections by Category (Totals)",
      "description": "Cumulative guardrail detections per category (bulwark:detections:category).",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "hue"
          }
        }
      },
      "targets": [
        {
          "expr": "topk(15, sum by (category)(bulwark_detections_by_category_total{category=~\"$category\"}))",
          "legendFormat": "{{category}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "legend": { "displayMode": "list", "placement": "right" },
        "tooltip": { "mode": "single" }
      },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true }
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Top Blocking by Tenant",
      "description": "Tenants with highest block counts and block rate (bulwark:usage:block vs bulwark:usage:total).",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "filterable": true, "align": "left" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Blocks" }, "properties": [{ "id": "custom.width", "value": 100 }, { "id": "custom.align", "value": "right" }] },
          { "matcher": { "id": "byName", "options": "Block Rate" }, "properties": [{ "id": "unit", "value": "percentunit" }, { "id": "custom.width", "value": 100 }] }
        ]
      },
      "targets": [
        {
          "expr": "topk(10, sum by (tenant)(bulwark_verdicts_by_tenant_total{verdict=\"block\"}))",
          "legendFormat": "{{tenant}}",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "topk(10, sum by (tenant)(bulwark_verdicts_by_tenant_total{verdict=\"block\"}) / clamp_min(sum by (tenant)(bulwark_requests_by_tenant_total), 1))",
          "legendFormat": "{{tenant}}",
          "refId": "B",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Blocks", "desc": true }],
        "footer": { "show": false }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "verdict": true },
            "renameByName": { "tenant": "Tenant", "Value #A": "Blocks", "Value #B": "Block Rate" }
          }
        },
        {
          "id": "sortBy",
          "options": { "sort": [{ "field": "Blocks", "desc": true }] }
        }
      ]
    },
    {
      "id": 9,
      "title": "Per-Tenant Verdict Breakdown",
      "description": "Verdict counts per tenant (bulwark:usage:*). Shows where allow/block/warn/redact traffic concentrates.",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "filterable": true, "align": "left" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Count" }, "properties": [{ "id": "custom.width", "value": 120 }, { "id": "custom.align", "value": "right" }] }
        ]
      },
      "targets": [
        {
          "expr": "sum by (tenant, verdict)(bulwark_verdicts_by_tenant_total)",
          "legendFormat": "{{tenant}} — {{verdict}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Count", "desc": true }],
        "footer": { "show": true, "reducer": ["sum"] }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": { "tenant": "Tenant", "verdict": "Verdict", "Value": "Count" }
          }
        }
      ]
    }
  ],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  }
}
