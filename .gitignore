# ============================================================
# Sentinel Gateway — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg
.venv/
venv/
env/

# --- Node (admin UI build tools) ---
node_modules/
package-lock.json

# --- Secrets (NEVER commit) ---
# SECURITY FIX (VULN 3.3): Block ALL files in secrets/ regardless of extension
secrets/*
!secrets/init.sh
!secrets/README.md
*.key
*.pem
*.cert
credentials.json
/secrets.yaml
.env
.env.local
.env.production
.env.*

# --- Runtime data (generated at runtime) ---
data/
shared/
# Local SIEM lab (Splunk/Graylog/Wazuh) creds + generated evidence — never track.
siem-e2e/
# Test datasets/fixtures are SOURCE, not runtime data — the correlation FP/FN
# corpus is imported by committed tests, so it must stay tracked despite `data/`.
!tests/data/
!tests/data/**
tests/data/**/__pycache__/
# Vendored evaluation corpora are SOURCE too: a reproducible, license-attributed
# subset of public datasets (regenerated by scripts/fetch-eval-corpora.py) that
# committed tests + the benchmark load. Keep tracked despite `data/`.
!src/evaluation/data/
!src/evaluation/data/**
# Internal reports stay private (pentest / redteam / qa / benchmarks),
# except the launch-facing blog evidence which is intentionally published.
reports/*
!reports/blog-evidence/
*.db
*.db-shm
*.db-wal

# --- ML Models (large, downloaded on demand) ---
models/*.onnx
models/*/model.onnx
models/*/tokenizer.json
# fastText language-ID model (lid.176.ftz, ~917 KB — download-models.py --fasttext)
models/*.ftz
models/**/*.ftz
# HuggingFace / sentence-transformers cache (blobs, snapshots, refs)
models/sentence-transformers/
models/**/*.safetensors
models/**/blobs/
models/**/snapshots/

# --- Internal business/strategy docs (NEVER commit) ---
MARKET-COMPARISON-*.md

# --- Local-only planning and lab records (publication boundary) ---
/debates/
/docs/internal/
/docs/IMPROVEMENT-PLAN.md
/docs/RELEASE-ACCEPTANCE-LATEST.md
/docs/SECURITY-STANDARDS-ADOPTION.md
/docs/SECURITY-VERIFICATION-MATRIX.md
/docs/ENTERPRISE-DELIVERY-STATUS.md
/docs/INDEPENDENT-RELEASE-REVIEW.md
/docs/KUBERNETES-CHART-RESULTS.md
/docs/KUBERNETES-NETWORK-INTERVENTION.md
/docs/KUBERNETES-REDIS-RECOVERY.md
/docs/KUBERNETES-VALIDATION-STATUS.md
/docs/LIVE-SIEM-VALIDATION.md
/docs/LIVE-STORES-VALIDATION.md
/docs/LOAD-CHARACTERIZATION.md
/docs/LOCAL-CANDIDATE-PACKAGING.md
/docs/MINIKUBE-NETPOL-RESULTS.md
/docs/POST-REBOOT-RECOVERY.md
/docs/PRODUCTION-VALIDATION.md
/docs/PROXY-INDEPENDENT-REVIEW.md
/docs/SECURITY-COVERAGE-HARDENING.md
/docs/STORAGE-SANDBOX-VALIDATION.md
/docs/PILOT-ACCEPTANCE.md
/docs/CHATBOT-E2E-LAB.md
# --- End local-only publication boundary ---

# --- Logs ---
*.log
logs/

# --- IDE / Editors ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OpenCode / Agent context ---
.opencode/

# --- OS files ---
.DS_Store
Thumbs.db

# --- IOC database (large, auto-generated from feeds) ---
config/iocs.json

# --- Docker local state ---
docker-compose.override.yml

# --- Helm packaging artifacts ---
helm/sentinel-gateway/charts/
*.tgz

# --- Temporary / test artifacts ---
htmlcov/
coverage.xml
.coverage
*.prof
/tmp/
# Isolated local agent verification artifacts on the data filesystem.
/.evaluation-tmp/
/.pytest-p8-regression/
/.pytest-p8-tmp/
